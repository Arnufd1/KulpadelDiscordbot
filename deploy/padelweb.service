[Unit]
Description=Sigmadvisor Padel web portal
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=padelbot
Group=padelbot
SupplementaryGroups=kvm
WorkingDirectory=/opt/padelbot
Environment=HOME=/var/lib/padelbot
Environment=ANDROID_USER_HOME=/var/lib/padelbot/.android
Environment=ANDROID_EMULATOR_FEATURES=-Vulkan
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/padelbot/.tools/playwright
Environment=PYTHONUNBUFFERED=1
LoadCredential=card-vault.key:/etc/padelbot/card-vault.key
Environment=PADELWEB_CARD_VAULT_KEY_FILE=%d/card-vault.key
LimitCORE=0
ExecStart=/opt/padelbot/.venv/bin/python -m padelbot.web
Restart=always
RestartSec=5
TimeoutStopSec=50
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/padelbot/data /var/lib/padelbot

[Install]
WantedBy=multi-user.target
