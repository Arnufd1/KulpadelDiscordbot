# KU Leuven OIDC client (extracted from HAR)
KUL_CLIENT_ID=usc
KUL_AUTHORIZE_URL=https://idp.kuleuven.be/idp/profile/oidc/authorize
KUL_TOKEN_URL=https://idp.kuleuven.be/idp/profile/oidc/token
KUL_REDIRECT_URI=https://usc.kuleuven.cloud/oidc/auth-callback
KUL_SCOPE="openid profile email cardinfo offline_access"

# Booking API
BACKBONE_API_BASE=https://backbone-web-api.production.leuven.delcom.nl

# Storage encryption — generated by `padelbot init-key`. Keep this file outside git.
PADELBOT_KEY_FILE=./data/master.key

# Where the encrypted token blob lives
PADELBOT_TOKEN_FILE=./data/tokens.enc

# Browser storage state (cookies + localStorage) saved after Playwright login.
# Used for silent renewal — we hit /authorize?prompt=none with these cookies
# and get a fresh access_token without MFA, until the IdP session expires.
PADELBOT_STORAGE_FILE=./data/storage_state.json

# Discord webhook for fast one-way alerts (Server Settings → Integrations → Webhooks → New Webhook).
# Optional once you have the bot — but kept as a fallback for "auth dead" type alerts.
DISCORD_WEBHOOK_URL=

# --- Discord bot (interactive, two-way) ---
# 1) https://discord.com/developers/applications → New Application → Bot → Reset Token → copy here
DISCORD_BOT_TOKEN=

# 2) Discord → Settings → Advanced → enable Developer Mode. Right-click your name → Copy User ID.
DISCORD_OWNER_ID=
# 3) (Optional but recommended) Right-click your server → Copy Server ID. Set this for instant slash command updates;
#    leave blank for global commands which can take up to 1 hour to propagate.
DISCORD_GUILD_ID=

# Booking preferences
PADEL_MEMBER_ID=399251
PADEL_OPENS_DAYS_AHEAD=7
PADEL_OPEN_HOUR_LOCAL=0          # hour-of-day in Brussels time when slots open (tune if wrong)
PADEL_FIRE_OFFSET_MS=200
PADEL_LOCAL_TZ=Europe/Brussels

# Recurring booking rules (SQLite)
PADELBOT_RULES_FILE=./data/rules.sqlite3

# Credit card for headless auto-pay (Playwright drives the Worldline page).
# .env is gitignored — these stay local only. Alternative: `padelbot set-card`
# stores them encrypted in data/card.enc.
KUL_CARD_HOLDER=
KUL_CARD_NUMBER=
KUL_CARD_EXP_MONTH=
KUL_CARD_EXP_YEAR=
KUL_CARD_CVV=

# Logging
LOG_LEVEL=INFO
