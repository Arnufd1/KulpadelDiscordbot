# Required to run the Discord bot. Fill in your own values in .env.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=0
DISCORD_GUILD_ID=0

# Optional webhook for CLI notifications.
DISCORD_WEBHOOK_URL=

# Brussels local time. The actual opening hour still needs live verification.
PADEL_LOCAL_TZ=Europe/Brussels
PADEL_OPENS_DAYS_AHEAD=7
PADEL_OPEN_HOUR_LOCAL=0
PADEL_FIRE_OFFSET_MS=200

# HTTP renewal and read-only polling, in seconds.
PADELBOT_KEEPALIVE_INTERVAL_S=1500
PADELBOT_SLOTS_REFRESH_S=120
PADELBOT_BOOKINGS_REFRESH_S=300
PADELBOT_WATCHER_POLL_S=120
LOG_LEVEL=INFO

# Session state is kept under data/ (ignored by Git).
PADELBOT_KEY_FILE=./data/master.key
PADELBOT_TOKEN_FILE=./data/tokens.enc
PADELBOT_STORAGE_FILE=./data/storage_state.json
PADELBOT_RULES_FILE=./data/rules.sqlite3

# Registered Android for passwordless Authenticator login.
# Enable autologin only after the actual phone UI has been calibrated and tested.
PADELBOT_ANDROID_SERIAL=
# Stable handset identity from `padelbot android doctor`; recommended for Wi-Fi.
PADELBOT_ANDROID_DEVICE_ID=
PADELBOT_ANDROID_PROFILE_FILE=./data/android_profile.json
PADELBOT_ANDROID_PIN_FILE=./data/android_pin.enc
PADELBOT_ANDROID_FAILURE_FILE=./data/android_autologin_failure.json
PADELBOT_ANDROID_AUTOLOGIN=false
# PADELBOT_ANDROID_ADB=./.tools/android/platform-tools/adb.exe

# Optional registered virtual Android, after setup and a successful fresh login.
# Requires an explicit serial such as emulator-5554 and its own profile/PIN files.
# A bot-started emulator stops after login (also on failure); HTTP renewal needs none.
PADELBOT_ANDROID_EMULATOR_AUTOSTART=false
PADELBOT_ANDROID_EMULATOR_NAME=KulPadelAuth
PADELBOT_ANDROID_EMULATOR_HOME=./data/emulators
# Optional limits for a small host. Omit to use the calibrated AVD configuration.
# PADELBOT_ANDROID_EMULATOR_MEMORY_MB=1536
# PADELBOT_ANDROID_EMULATOR_CORES=1

# Optional API/OIDC overrides; these match the defaults in config.py.
KUL_CLIENT_ID=usc
KUL_AUTHORIZE_URL=https://idp.kuleuven.be/idp/profile/oidc/authorize
KUL_TOKEN_URL=https://idp.kuleuven.be/idp/profile/oidc/token
KUL_REDIRECT_URI=https://usc.kuleuven.cloud/oidc/auth-callback
KUL_SCOPE=openid profile email cardinfo offline_access
BACKBONE_API_BASE=https://backbone-web-api.production.leuven.delcom.nl
PADEL_MEMBER_ID=0

# Optional card details. Prefer `padelbot set-card` for encrypted storage.
# The Worldline browser driver needs the login extra and Chromium.
# KUL_CARD_HOLDER=
# KUL_CARD_NUMBER=
# KUL_CARD_EXP_MONTH=0
# KUL_CARD_EXP_YEAR=0
# KUL_CARD_CVV=
